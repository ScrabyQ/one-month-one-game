---
import AboutChallenge from "../components/AboutChallenge.astro";
import ArchivePreview from "../components/ArchivePreview.astro";
import GameGrid from "../components/GameGrid.astro";
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import { jams } from "../config/jams";
import { getSnapshotForRound } from "../lib/data/snapshots";
import { getFeaturedRound, getJamStatus, validateJamRounds } from "../lib/jams/status";
import type { GameSnapshot } from "../lib/domain/types";

validateJamRounds(jams);
const now = new Date();
const featuredRound = getFeaturedRound(jams, now);
const featuredSnapshot = getSnapshotForRound(featuredRound);
const archiveRounds = [...jams]
  .filter((round) => round.id !== featuredRound.id)
  .sort((left, right) => +new Date(right.startsAt) - +new Date(left.startsAt))
  .slice(0, 4);
const archiveSnapshots = new Map<string, GameSnapshot>(
  archiveRounds.map((round) => [round.id, getSnapshotForRound(round)]),
);
---

<Layout
  title={`${featuredRound.monthLabel} — Один месяц, одна игра`}
  description="Ежемесячный челлендж для разработчиков игр: одна тема, один месяц, одна законченная игра."
  canonicalPath="/"
>
  <Hero
    round={featuredRound}
    snapshot={featuredSnapshot}
    status={getJamStatus(featuredRound, now)}
  />

  <section class="gallery-section section-shell" aria-labelledby="gallery-title">
    <div class="section-heading section-heading--gallery">
      <div>
        <p class="eyebrow">{featuredRound.monthLabel}</p>
        <h2 id="gallery-title">Галерея месяца</h2>
      </div>
      <p class="section-heading__aside">Каждая игра — ещё одна законченная история.</p>
    </div>
    <GameGrid games={featuredSnapshot.games} round={featuredRound} />
  </section>

  <AboutChallenge />
  <ArchivePreview rounds={archiveRounds} snapshots={archiveSnapshots} />
</Layout>
