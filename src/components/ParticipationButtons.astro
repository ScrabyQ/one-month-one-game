---
import type { JamRound } from "../lib/domain/types";
import { providerRegistry } from "../lib/providers/registry";

interface Props {
  round: JamRound;
  compact?: boolean;
}

const { round, compact = false } = Astro.props;
const providers = round.providers.map((config) => {
    const meta = providerRegistry.getMeta(config.type);
    const href = config.enabled ? providerRegistry.getParticipationUrl(config) : undefined;
    return { href, meta };
  });
const links = providers.filter((provider): provider is typeof provider & { href: string } => Boolean(provider.href));
---

{links.length > 0 ? (
  <div class:list={["participation-buttons", { "participation-buttons--compact": compact }]}>
    {links.map((link) => (
      <a
        class="btn btn-primary participation-button"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Принять участие через ${link.meta.label}`}
      >
        <span class="participation-button__copy">
          <strong>Принять участие</strong>
          <small>через {link.meta.label}</small>
        </span>
        <span class="participation-button__arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
) : (
  <>
    {providers.length > 0 && (
      <div class:list={["participation-buttons", { "participation-buttons--compact": compact }]}>
        {providers.map(({ meta }) => (
          <span class="btn btn-primary participation-button participation-button--disabled" aria-disabled="true">
            <span class="participation-button__copy">
              <strong>Принять участие</strong>
              <small>через {meta.label}</small>
            </span>
            <span class="participation-button__arrow" aria-hidden="true">↗</span>
          </span>
        ))}
      </div>
    )}
    {providers.length > 0 && (
      <p class="participation-placeholder" role="status">
        Ссылка на участие появится после настройки {providers.map(({ meta }) => meta.label).join(" или ")}.
      </p>
    )}
  </>
)}
