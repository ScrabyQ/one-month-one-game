---
import type { JamRound } from "../lib/domain/types";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/types";
import { providerRegistry } from "../lib/providers/registry";

interface Props {
  round: JamRound;
  compact?: boolean;
  locale: Locale;
}

const { round, compact = false, locale } = Astro.props;
const { participationButtons } = getTranslations(locale);
const providers = [
  ...new Map(
    round.providers.map((config) => {
      const meta = providerRegistry.getMeta(config.type);
      const href = config.enabled ? providerRegistry.getParticipationUrl(config) : undefined;
      return [config.type, { href, meta }] as const;
    }),
  ).values(),
];
const links = providers.filter((provider) => Boolean(provider.href));
const missingProviders = providers.filter((provider) => !provider.href);
const primaryLink = links[0];
---

{providers.length === 1 ? (
  <div class:list={["participation-buttons", { "participation-buttons--compact": compact }]}>
    {primaryLink ? (
      <a
        class="btn btn-primary participation-button"
        href={primaryLink.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={participationButtons.enterThrough(primaryLink.meta.label)}
      >
        <span class="participation-button__copy">
          <strong>{participationButtons.joinCurrentRound}</strong>
          <small>{participationButtons.through(primaryLink.meta.label)}</small>
        </span>
        <span class="motion-arrow participation-button__arrow" aria-hidden="true">↗</span>
      </a>
    ) : (
      <span class="btn btn-primary participation-button participation-button--disabled" aria-disabled="true">
        <span class="participation-button__copy">
          <strong>{participationButtons.joinCurrentRound}</strong>
          <small>{participationButtons.setupLink}</small>
        </span>
        <span class="motion-arrow participation-button__arrow" aria-hidden="true">↗</span>
      </span>
    )}
    {missingProviders.length > 0 && (
      <p class="participation-placeholder" role="status">
        {participationButtons.linkWillAppear(missingProviders[0]?.meta.label ?? "")}
      </p>
    )}
  </div>
): providers.length > 1 ? (
  <div
    class:list={[
      "participation-buttons",
      "participation-buttons--multi",
      { "participation-buttons--compact": compact },
    ]}
  >
    <strong class="participation-buttons__heading">{participationButtons.joinCurrentRound}</strong>
    <div class="participation-buttons__options">
      {providers.map(({ href, meta }) => (
        href ? (
          <a
            class="participation-option"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={participationButtons.enterThrough(meta.label)}
          >
            {meta.label} <span class="motion-arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="participation-option participation-option--disabled" aria-disabled="true">
            {meta.label} <span class="motion-arrow" aria-hidden="true">↗</span>
          </span>
        )
      ))}
    </div>
    {links.length === 0 ? (
      <p class="participation-placeholder" role="status">
        {participationButtons.linksWillAppear(participationButtons.joinLabels(providers.map(({ meta }) => meta.label)))}
      </p>
    ) : missingProviders.length > 0 ? (
      <p class="participation-placeholder" role="status">
        {participationButtons.linksWillAppear(participationButtons.joinLabels(missingProviders.map(({ meta }) => meta.label)))}
      </p>
    ) : null}
  </div>
): null}
