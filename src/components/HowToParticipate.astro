---
import type { JamRound } from "../lib/domain/types";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/types";
import { providerRegistry } from "../lib/providers/registry";
import { getLocalizedPath } from "../lib/site";

interface Props {
  round: JamRound;
  locale: Locale;
}

const { round, locale } = Astro.props;
const { participation } = getTranslations(locale);
const rulesPath = getLocalizedPath("/rules/", locale);
const providerLabels = [...new Set(round.providers.map((config) => providerRegistry.getMeta(config.type).label))];
const uploadDestination = providerLabels.length === 1
  ? providerLabels[0]
  : providerLabels.length > 1
    ? participation.supportedPlatform
    : participation.genericPlatform;

const steps = participation.steps.map((step, index) => index === 1
  ? { ...step, title: participation.uploadTo(uploadDestination) }
  : step);
---

<section id="participate" class="how-section section-shell" aria-labelledby="how-title">
  <div class="section-heading how-section__heading">
    <div>
      <p class="eyebrow">{participation.eyebrow}</p>
      <h2 id="how-title">{participation.title}</h2>
    </div>
    <p class="section-heading__aside">{participation.aside}</p>
  </div>

  <ol class="how-steps">
    {steps.map((step) => (
      <li class="how-step">
        <span class="how-step__number" aria-hidden="true">{step.number}</span>
        <div>
          <h3>{step.title}</h3>
          <p>{step.detail}</p>
        </div>
      </li>
    ))}
  </ol>

  <p class="how-section__note">{participation.note}</p>
  <a class="text-link how-section__rules-link" href={rulesPath}>
    {participation.rulesLink} <span class="motion-arrow" aria-hidden="true">→</span>
  </a>
</section>
