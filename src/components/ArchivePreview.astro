---
import type { GameSnapshot, JamRound } from "../lib/domain/types";
import { formatGameCount, formatRoundNumber } from "../lib/i18n/ru";
import { getRoundPresentation } from "../lib/jams/presentation";
import { getArchiveTheme } from "../lib/jams/status";
import { withBase } from "../lib/site";
import ArchiveEmptyState from "./ArchiveEmptyState.astro";

interface Props {
  rounds: JamRound[];
  snapshots: Map<string, GameSnapshot>;
}

const { rounds, snapshots } = Astro.props;
---

<section class="archive-preview section-shell">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Следы прошлых месяцев</p>
      <h2>Архив</h2>
    </div>
    <a class="text-link" href={withBase("/archive/")}>Смотреть весь архив <span class="motion-arrow" aria-hidden="true">↗</span></a>
  </div>

  {rounds.length > 0 ? (
    <ul class="archive-preview__list">
      {rounds.map((round) => {
        const presentation = getRoundPresentation(round);
        return (
          <li>
            <a
              class="archive-row archive-row--preview"
              href={withBase(`/jam/${round.slug}/`)}
              style={`--round-accent: ${presentation.accent}`}
            >
              <span class="archive-row__index" aria-hidden="true">{formatRoundNumber(round.round)}</span>
              <span class="archive-row__month">{round.monthLabel}</span>
              <span class="archive-row__theme">«{getArchiveTheme(round)}»</span>
              <span class="archive-row__count">{formatGameCount(snapshots.get(round.id)?.games.length ?? 0)}</span>
              <span class="motion-arrow archive-row__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        );
      })}
    </ul>
  ) : (
    <ArchiveEmptyState compact />
  )}
</section>
