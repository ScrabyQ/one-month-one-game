---
import type { GameEntry } from "../lib/domain/types";
import { getSubmissionPresentation } from "../lib/games/presentation";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/types";
import { getInitials } from "../lib/ui";
import ProviderBadge from "./ProviderBadge.astro";

interface Props {
  game: GameEntry;
  index: number;
  loading?: "eager" | "lazy";
  isLatest?: boolean;
  now?: Date;
  locale: Locale;
}

const { game, index, loading = "lazy", isLatest = false, now = new Date(), locale } = Astro.props;
const translations = getTranslations(locale);
const initials = getInitials(game.title, translations.common.initialsFallback);
const submission = getSubmissionPresentation(game.submittedAt, now, locale);
---

<a
  class:list={["game-card", { "game-card--latest": isLatest }]}
  href={game.url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={translations.game.openAria(game.title, isLatest)}
>
  <div class="game-card__cover" data-cover-frame>
    <div class="cover-fallback" aria-hidden="true">
      <span class="cover-fallback__mark">{initials}</span>
      <span class="cover-fallback__caption">{translations.game.fallbackCaptionLineOne}<br />{translations.game.fallbackCaptionLineTwo}</span>
    </div>
    {game.coverUrl && (
      <img
        src={game.coverUrl}
        alt={translations.game.coverAlt(game.title)}
        loading={loading}
        decoding="async"
        data-cover-image
      />
    )}
    <span class="game-card__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
    {isLatest && <span class="game-card__latest">{translations.game.latestLabel}</span>}
  </div>
  <div class="game-card__body">
    <div class="game-card__title-row">
      <h3>{game.title}</h3>
      <ProviderBadge provider={game.provider} locale={locale} />
    </div>
    <p class="game-card__author">{game.author.name}</p>
    {submission.iso && submission.dateLabel && (
      <div class="game-card__submission">
        <time datetime={submission.iso}>{submission.dateLabel}</time>
        {submission.isRecent && <span class="game-card__new">{translations.game.newLabel}</span>}
      </div>
    )}
    {game.description && <p class="game-card__description">{game.description}</p>}
    <span class="game-card__external" aria-hidden="true">{translations.game.viewGame} <span class="motion-arrow">↗</span></span>
  </div>
</a>

<script>
  document.querySelectorAll<HTMLImageElement>("[data-cover-image]").forEach((image) => {
    image.addEventListener(
      "error",
      () => {
        image.hidden = true;
        image.closest("[data-cover-frame]")?.setAttribute("data-image-failed", "true");
      },
      { once: true },
    );
  });
</script>
