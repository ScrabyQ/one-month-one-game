---
import type { GameSnapshot, JamRound } from "../lib/domain/types";
import { formatGameCount } from "../lib/i18n/ru";
import { getArchiveTheme } from "../lib/jams/status";
import { withBase } from "../lib/site";

interface Props {
  rounds: JamRound[];
  snapshots: Map<string, GameSnapshot>;
}

const { rounds, snapshots } = Astro.props;
---

<ul class="archive-list">
  {rounds.map((round, index) => {
    const snapshot = snapshots.get(round.id);
    return (
      <li>
        <a class="archive-row archive-row--full" href={withBase(`/jam/${round.slug}/`)}>
          <span class="archive-row__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <span class="archive-row__month">{round.monthLabel}</span>
          <span class="archive-row__theme">«{getArchiveTheme(round)}»</span>
          <span class="archive-row__count">{formatGameCount(snapshot?.games.length ?? 0)}</span>
          <span class="archive-row__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    );
  })}
</ul>
