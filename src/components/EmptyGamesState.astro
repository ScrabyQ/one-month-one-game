---
import type { JamRound } from "../lib/domain/types";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/types";
import ParticipationButtons from "./ParticipationButtons.astro";

interface Props {
  round: JamRound;
  locale: Locale;
}

const { round, locale } = Astro.props;
const { emptyGames } = getTranslations(locale);
---

<div class="empty-games" role="status">
  <span class="empty-games__index" aria-hidden="true">00</span>
  <div>
    <p class="empty-games__title">{emptyGames.title}</p>
    <p class="empty-games__copy">{emptyGames.copyLineOne}<br />{emptyGames.copyLineTwo}</p>
  </div>
  <ParticipationButtons round={round} compact locale={locale} />
</div>
