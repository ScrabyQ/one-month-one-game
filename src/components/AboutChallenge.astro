---
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translations = getTranslations(locale);
---

<section id="about" class="about-section section-shell">
  <div class="about-section__label eyebrow">{translations.about.label}</div>
  <div class="about-section__content">
    <h2>{translations.about.headingLineOne}<br />{translations.about.headingLineTwo}<br /><span>{translations.about.headingLineThree}</span></h2>
    <div class="about-section__copy">
      <p>{translations.about.firstParagraph}</p>
      <p>{translations.about.secondParagraph}</p>
    </div>
  </div>
</section>
