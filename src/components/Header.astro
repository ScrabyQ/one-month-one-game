---
import { withBase } from "../lib/site";
import { jams } from "../config/jams";
import { getFeaturedRound } from "../lib/jams/status";

const currentPath = Astro.url.pathname;
const homePath = new URL(withBase("/"), Astro.url).pathname;
const archivePath = new URL(withBase("/archive/"), Astro.url).pathname;
const currentRoundPath = new URL(
  withBase("/jam/" + getFeaturedRound(jams, new Date()).slug + "/"),
  Astro.url,
).pathname;
const isCurrentPath = (path: string) => currentPath === path;
const isCurrentMonth = currentPath === homePath || currentPath === currentRoundPath;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={withBase("/")} aria-label="Один месяц — одна игра, на главную">
      <span class="brand__mark" aria-hidden="true">01</span>
      <span class="brand__text">Один месяц<br /><span>одна игра</span></span>
    </a>

    <nav class="site-nav site-nav--desktop" aria-label="Основная навигация">
      <a
        class:list={{ "site-nav__current": isCurrentMonth }}
        href={withBase("/")}
        aria-current={isCurrentMonth ? "page" : undefined}
      >Текущий месяц</a>
      <a
        class:list={{ "site-nav__current": isCurrentPath(archivePath) }}
        href={withBase("/archive/")}
        aria-current={isCurrentPath(archivePath) ? "page" : undefined}
      >Архив</a>
      <a href={withBase("/#about")}>О проекте</a>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Открыть меню"><span aria-hidden="true">Меню</span><span class="mobile-nav__icon" aria-hidden="true">+</span></summary>
      <nav class="site-nav site-nav--mobile" aria-label="Мобильная навигация">
        <a
          class:list={{ "site-nav__current": isCurrentMonth }}
          href={withBase("/")}
          aria-current={isCurrentMonth ? "page" : undefined}
        >Текущий месяц</a>
        <a
          class:list={{ "site-nav__current": isCurrentPath(archivePath) }}
          href={withBase("/archive/")}
          aria-current={isCurrentPath(archivePath) ? "page" : undefined}
        >Архив</a>
        <a href={withBase("/#about")}>О проекте</a>
      </nav>
    </details>
  </div>
</header>
