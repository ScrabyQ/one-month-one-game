---
import type { JamRound } from "../lib/domain/types";
import { withBase } from "../lib/site";

interface Props {
  currentRound: JamRound;
}

const { currentRound } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p>Один месяц — одна игра</p>
    <nav class="site-footer__links" aria-label="Ссылки в подвале">
      <a href={withBase("/jam/" + currentRound.slug + "/")}>Текущий раунд</a>
      <a href={withBase("/#participate")}>Принять участие</a>
      <a href={withBase("/archive/")}>Архив</a>
    </nav>
    <p class="site-footer__note">{currentYear} · Статическая витрина независимых игр</p>
  </div>
</footer>
