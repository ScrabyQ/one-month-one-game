---
import type { GameSnapshot, JamRound, JamStatus } from "../lib/domain/types";
import { formatGameCount } from "../lib/i18n/ru";
import { getStatusLabel } from "../lib/jams/status";
import Countdown from "./Countdown.astro";
import ParticipationButtons from "./ParticipationButtons.astro";

interface Props {
  round: JamRound;
  snapshot: GameSnapshot;
  status: JamStatus;
  compact?: boolean;
}

const { round, snapshot, status, compact = false } = Astro.props;
---

<section class:list={["hero", { "hero--compact": compact }]}>
  <div class="shell">
    <div class="hero__meta">
      <span class="eyebrow">{round.monthLabel}</span>
      <div class="hero__status-row">
        {round.dataMode === "demo" && <span class="demo-badge">ДЕМО-ДАННЫЕ</span>}
        <span class:list={["status-badge", `status-badge--${status}`]}>
          <span class="status-badge__dot" aria-hidden="true"></span>
          {getStatusLabel(status)}
        </span>
      </div>
    </div>

    <div class="hero__grid">
      <div class="hero__title-block">
        <p class="hero__kicker">Постоянный челлендж</p>
        <h1>Один месяц —<br /><span>одна игра</span></h1>
        <p class="hero__intro">Сделай. Закончи. Покажи.</p>
      </div>

      <div class="hero__theme-block">
        <p class="eyebrow hero__theme-label">Тема месяца</p>
        <p class="hero__theme">«{round.theme}»</p>
        <p class="hero__description">{round.description}</p>
        <ParticipationButtons round={round} />
      </div>
    </div>

    <div class="hero__footer">
      <Countdown round={round} />
      <div class="hero__count">
        <span class="countdown__label">В галерее</span>
        <strong>{formatGameCount(snapshot.games.length)}</strong>
      </div>
    </div>
  </div>
</section>
