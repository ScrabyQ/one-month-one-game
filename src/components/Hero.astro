---
import type { GameSnapshot, JamRound, JamStatus } from "../lib/domain/types";
import { formatGameCount, formatProviderCount, formatRoundNumber } from "../lib/i18n/ru";
import {
  formatJamDateRange,
  getStatusLabel,
  getThemePresentation,
} from "../lib/jams/status";
import Countdown from "./Countdown.astro";
import ParticipationButtons from "./ParticipationButtons.astro";

interface Props {
  round: JamRound;
  snapshot: GameSnapshot;
  status: JamStatus;
  compact?: boolean;
}

const { round, snapshot, status, compact = false } = Astro.props;
const theme = getThemePresentation(round);
const statusLabel = getStatusLabel(status);
const providerCount = new Set(
  round.providers.filter((provider) => provider.enabled).map((provider) => provider.type),
).size;
---

<section class:list={["hero", { "hero--compact": compact }]}>
  <div class="shell">
    <span class="hero__round-number" aria-hidden="true">{formatRoundNumber(round.round)}</span>
    <div class="hero__meta">
      <div class="hero__round-context">
        <span class="eyebrow">Раунд {formatRoundNumber(round.round)}</span>
        <span class="hero__round-divider" aria-hidden="true">·</span>
        <span class="eyebrow">{round.monthLabel}</span>
        <span class="hero__round-divider" aria-hidden="true">·</span>
        <span class:list={["status-badge", `status-badge--${status}`]}>
          <span class="status-badge__dot" aria-hidden="true"></span>
          {statusLabel}
        </span>
      </div>
      {round.dataMode === "demo" && <span class="demo-badge">ДЕМО-ДАННЫЕ</span>}
    </div>

    <div class="hero__grid">
      <div class="hero__title-block">
        <h1>Один месяц —<br /><span>одна игра</span></h1>
        <p class="hero__intro">Сделай. Закончи. Покажи.</p>
      </div>

      <div class:list={["hero__theme-block", { "hero__theme-block--pending": !theme.isAnnounced }]}>
        <p class="eyebrow hero__theme-label">Тема месяца</p>
        {theme.isAnnounced ? (
          <p class="hero__theme">«{theme.text}»</p>
        ) : (
          <p class="hero__theme-placeholder">{theme.text}</p>
        )}
        <p class="hero__description">{round.description}</p>
        <ParticipationButtons round={round} />
      </div>
    </div>

    <div class="hero__footer">
      <div class="hero__metric">
        <span class="hero__metric-label">Даты раунда</span>
        <strong>{formatJamDateRange(round)}</strong>
      </div>
      <Countdown round={round} />
      <div class="hero__metric">
        <span class="hero__metric-label">Площадки</span>
        <strong>{formatProviderCount(providerCount)}</strong>
      </div>
      <div class="hero__metric hero__metric--right">
        <span class="hero__metric-label">Уже в галерее</span>
        <strong>{formatGameCount(snapshot.games.length)}</strong>
      </div>
    </div>
  </div>
</section>
