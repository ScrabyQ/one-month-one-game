---
import type { GameSnapshot, JamRound, JamStatus } from "../lib/domain/types";
import {
  formatGameCount,
  formatJamDateRange,
  formatRoundNumber,
  formatStatusLabel,
  getJamContent,
  getThemePresentation,
  getTranslations,
} from "../lib/i18n";
import type { Locale } from "../lib/i18n/types";
import Countdown from "./Countdown.astro";
import HeroAtmosphere from "./HeroAtmosphere.astro";
import ParticipationButtons from "./ParticipationButtons.astro";
import RoundStats from "./RoundStats.astro";

interface Props {
  round: JamRound;
  snapshot: GameSnapshot;
  status: JamStatus;
  compact?: boolean;
  locale: Locale;
}

const { round, snapshot, status, compact = false, locale } = Astro.props;
const translations = getTranslations(locale);
const content = getJamContent(round, locale);
const theme = getThemePresentation(round, locale);
const statusLabel = formatStatusLabel(locale, status);
---

<section class:list={["hero", { "hero--compact": compact }]}>
  <HeroAtmosphere />
  <div class="shell">
    <span class="hero__round-number" data-hero-round-number aria-hidden="true">{formatRoundNumber(round.round)}</span>
    <div class="hero__meta">
      <div class="hero__round-context">
        <span class="eyebrow">{translations.hero.roundLabel(formatRoundNumber(round.round))}</span>
        <span class="hero__round-divider" aria-hidden="true">·</span>
        <span class="eyebrow">{content.monthLabel}</span>
        <span class="hero__round-divider" aria-hidden="true">·</span>
        <span class:list={["status-badge", `status-badge--${status}`]}>
          <span class="status-badge__dot" aria-hidden="true"></span>
          {statusLabel}
        </span>
      </div>
      {round.dataMode === "demo" && <span class="demo-badge">{translations.hero.demoBadge}</span>}
    </div>

    <div class="hero__grid">
      <div class="hero__title-block">
        <h1>{translations.hero.titleLineOne}<br /><span>{translations.hero.titleLineTwo}</span></h1>
        <p class="hero__intro">{translations.hero.tagline}</p>
      </div>

      <div class:list={["hero__theme-block", { "hero__theme-block--pending": !theme.isAnnounced }]}>
        <p class="eyebrow hero__theme-label">{translations.hero.themeLabel}</p>
        {theme.isAnnounced ? (
          <p class="hero__theme">«{theme.text}»</p>
        ) : (
          <p class="hero__theme-placeholder">{theme.text}</p>
        )}
        <p class="hero__description">{content.description}</p>
        <ParticipationButtons round={round} locale={locale} />
      </div>
    </div>

    <div class="hero__footer">
      <div class="hero__metric">
        <span class="hero__metric-label">{translations.hero.datesLabel}</span>
        <strong>{formatJamDateRange(locale, round)}</strong>
      </div>
      <Countdown round={round} locale={locale} />
      <RoundStats round={round} stats={snapshot.stats} locale={locale} />
      <div class="hero__metric hero__metric--right">
        <span class="hero__metric-label">{translations.hero.inGalleryLabel}</span>
        <strong>{formatGameCount(locale, snapshot.games.length)}</strong>
      </div>
    </div>
  </div>
</section>
